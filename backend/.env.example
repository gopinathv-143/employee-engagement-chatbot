# EMBED_MODEL_NAME=BAAI/bge-small-en-v1.5
DATA_FILE=../data/employee_engagement_5000.xlsx
SQLITE_DB_PATH=db/engagement.db
INDEX_STORAGE_DIR=storage
AGENT_MAX_TOOL_ITERATIONS=5
